# Canonical origin, no trailing slash. Drives metadataBase, canonical tags,
# the sitemap, robots.txt and citation URLs. Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.globaleconindicators.info

# Hosted contact form endpoint (Formspree or compatible). Without it the contact
# page falls back to a mailto link instead of discarding messages.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Upstream data API keys used by the server-side proxy routes.
FRED_API_KEY=
EIA_API_KEY=
